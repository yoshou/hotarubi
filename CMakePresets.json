{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "gcc-debug",
      "inherits": "base",
      "cacheVariables": { "CMAKE_CXX_COMPILER": "g++-14", "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "gcc-release",
      "inherits": "base",
      "cacheVariables": { "CMAKE_CXX_COMPILER": "g++-14", "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "clang-debug",
      "inherits": "base",
      "cacheVariables": { "CMAKE_CXX_COMPILER": "clang++-21", "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "clang-release",
      "inherits": "base",
      "cacheVariables": { "CMAKE_CXX_COMPILER": "clang++-21", "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "sanitize",
      "inherits": "base",
      "cacheVariables": { "CMAKE_CXX_COMPILER": "clang++-21", "CMAKE_BUILD_TYPE": "Debug", "HOTARUBI_SANITIZE": "ON" }
    },
    {
      "name": "coverage",
      "inherits": "base",
      "cacheVariables": { "CMAKE_CXX_COMPILER": "clang++-21", "CMAKE_BUILD_TYPE": "Debug", "HOTARUBI_COVERAGE": "ON" }
    },
    {
      "name": "tidy",
      "inherits": "base",
      "cacheVariables": { "CMAKE_CXX_COMPILER": "clang++-21", "CMAKE_BUILD_TYPE": "Debug", "CMAKE_CXX_CLANG_TIDY": "clang-tidy-21" }
    },
    {
      "name": "aarch64-release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "Linux",
        "CMAKE_SYSTEM_PROCESSOR": "aarch64",
        "CMAKE_CXX_COMPILER": "aarch64-linux-gnu-g++-14",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXE_LINKER_FLAGS": "-static"
      }
    }
  ],
  "buildPresets": [
    { "name": "gcc-debug", "configurePreset": "gcc-debug" },
    { "name": "gcc-release", "configurePreset": "gcc-release" },
    { "name": "clang-debug", "configurePreset": "clang-debug" },
    { "name": "clang-release", "configurePreset": "clang-release" },
    { "name": "sanitize", "configurePreset": "sanitize" },
    { "name": "coverage", "configurePreset": "coverage" },
    { "name": "tidy", "configurePreset": "tidy" },
    { "name": "aarch64-release", "configurePreset": "aarch64-release" }
  ],
  "testPresets": [
    { "name": "gcc-debug", "configurePreset": "gcc-debug", "output": { "outputOnFailure": true } },
    { "name": "gcc-release", "configurePreset": "gcc-release", "output": { "outputOnFailure": true } },
    { "name": "clang-debug", "configurePreset": "clang-debug", "output": { "outputOnFailure": true } },
    { "name": "clang-release", "configurePreset": "clang-release", "output": { "outputOnFailure": true } },
    { "name": "sanitize", "configurePreset": "sanitize", "output": { "outputOnFailure": true } },
    {
      "name": "coverage",
      "configurePreset": "coverage",
      "output": { "outputOnFailure": true },
      "environment": { "LLVM_PROFILE_FILE": "${sourceDir}/build/coverage/profiles/%p.profraw" }
    }
  ]
}
