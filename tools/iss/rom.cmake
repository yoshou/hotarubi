file(READ "${INPUT}" text)

string(REGEX MATCH "RomPc \\[16\\] = '.([^}]*)" match "${text}")
string(REGEX MATCHALL "10'd[0-9]+" starts "${CMAKE_MATCH_1}")
list(LENGTH starts start_count)
if(NOT start_count EQUAL 16)
  message(FATAL_ERROR "${INPUT}: expected 16 RomPc entries, found ${start_count}")
endif()

string(REGEX MATCH "Rom \\[256\\] = '.([^}]*)" match "${text}")
string(REGEX MATCHALL "128'h[0-9a-fA-F]+" words "${CMAKE_MATCH_1}")
list(LENGTH words word_count)
if(NOT word_count EQUAL 256)
  message(FATAL_ERROR "${INPUT}: expected 256 Rom words, found ${word_count}")
endif()

set(out "#include \"rom.hpp\"\n\n#include <array>\n#include <cstdint>\n\n")
string(APPEND out "#include \"word.hpp\"\n\nnamespace hotarubi::iss {\n\n")
string(APPEND out "const std::array<uint32_t, kFixedOps> kRomStart = {\n")
foreach(start IN LISTS starts)
  string(REPLACE "10'd" "" value "${start}")
  string(APPEND out "    ${value},\n")
endforeach()
string(APPEND out "};\n\nconst std::array<Word128, kRomWords> kRom = {{\n")
foreach(word IN LISTS words)
  string(REPLACE "128'h" "" hex "${word}")
  string(LENGTH "${hex}" length)
  while(length LESS 32)
    set(hex "0${hex}")
    string(LENGTH "${hex}" length)
  endwhile()
  if(length GREATER 32)
    message(FATAL_ERROR "${INPUT}: Rom word ${word} is wider than 128 bits")
  endif()
  string(SUBSTRING "${hex}" 0 16 high)
  string(SUBSTRING "${hex}" 16 16 low)
  string(APPEND out "    {.low = 0x${low}, .high = 0x${high}},\n")
endforeach()
string(APPEND out "}};\n\n}  // namespace hotarubi::iss\n")

file(WRITE "${OUTPUT}.tmp" "${out}")
file(COPY_FILE "${OUTPUT}.tmp" "${OUTPUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUTPUT}.tmp")
